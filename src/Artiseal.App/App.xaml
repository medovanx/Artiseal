<Application x:Class="Artiseal.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Colour tokens -->
        <SolidColorBrush x:Key="Page" Color="#F6F5F2" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Line" Color="#E2DFD8" />
        <SolidColorBrush x:Key="Ink" Color="#1F1D1A" />
        <SolidColorBrush x:Key="Muted" Color="#5F5A52" />
        <SolidColorBrush x:Key="Accent" Color="#1E7A5A" />
        <SolidColorBrush x:Key="AccentHover" Color="#176548" />
        <SolidColorBrush x:Key="Good" Color="#2E7D32" />
        <SolidColorBrush x:Key="Warn" Color="#9A5B00" />
        <SolidColorBrush x:Key="Bad" Color="#B3261E" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- Selectable text that looks like a label (for the hash). -->
        <Style x:Key="Quiet" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Flat buttons: no shadow, no lift. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Resources>
</Application>
