<Window x:Class="Artiseal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Artiseal" Width="680" Icon="Assets/app.ico" SizeToContent="Height" MinHeight="300"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Ink}" AllowDrop="True" Drop="OnDrop">

    <StackPanel Margin="24,20,24,20">

        <!-- The file -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="FileName" Text="No file chosen" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="FileHash" Style="{StaticResource Quiet}" Text="Drop a file here, or choose one." Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Choose file" Style="{StaticResource Secondary}" Click="OnChooseFile" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Who published it -->
        <TextBlock Text="Who published it?" FontWeight="SemiBold" Margin="0,18,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="RepoBox" IsEditable="True" Padding="8,6" FontSize="14"
                      ToolTip="owner/repo, or paste the project's GitHub link"
                      KeyDown="OnRepoKeyDown" />
            <Button x:Name="CheckButton" Grid.Column="1" Content="Check" Style="{StaticResource Primary}" Click="OnCheck" Margin="10,0,0,0" IsEnabled="False" />
        </Grid>
        <TextBlock x:Name="RepoHint" Text="Type owner/repo, like cli/cli, or paste the project's GitHub link." Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <!-- The answer -->
        <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResultRepo" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ResultVerdict" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ResultMessage" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />

                <Grid x:Name="FactsGrid" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Workflow" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FactWorkflow" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="1" Text="Branch or tag" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FactRef" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="2" Text="Commit" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}"><Hyperlink x:Name="FactCommitLink" RequestNavigate="OnLink"><Run x:Name="FactCommit" /></Hyperlink></TextBlock>
                    <TextBlock Grid.Row="3" Text="Started by" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FactTrigger" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="4" Text="Signed" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="FactSigned" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="5" Text="Build run" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}"><Hyperlink x:Name="FactRunLink" RequestNavigate="OnLink"><Run Text="Open the run on GitHub" /></Hyperlink></TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <CheckBox x:Name="MenuToggle" Content="Show &quot;Check with Artiseal&quot; when I right-click a file" Margin="0,18,0,0"
                  Foreground="{StaticResource Muted}" Click="OnMenuToggle" />
    </StackPanel>
</Window>
